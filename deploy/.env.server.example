# Copy this to /opt/trucking-crm/.env ON THE DROPLET (142.93.9.208).
# Never commit real values. Pre-filled for repo mhcode17/prime + oneprimefleet.com;
# only the two CHANGE_ME lines need editing.

# ── Docker image (from your GitHub repo, lowercase) ──────────────
APP_IMAGE=ghcr.io/mhcode17/prime:latest

# ── Postgres (container) ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=trucking_crm

# ── App ──────────────────────────────────────────────────────────
# The password below MUST match POSTGRES_PASSWORD above. Host "db" is the
# compose service name.
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/trucking_crm?schema=public

# Generate on the server with:  openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Your domain (A record must point to 142.93.9.208)
DOMAIN=oneprimefleet.com
NEXT_PUBLIC_APP_URL=https://oneprimefleet.com
