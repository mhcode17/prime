# Copy to `.env` on the server (or set as environment variables / GitHub Secrets).
# NEVER commit real values.

# PostgreSQL — use a DigitalOcean Managed Database or the bundled Postgres container.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Session signing secret — generate a strong random string, e.g.:
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Public base URL of the deployed app
NEXT_PUBLIC_APP_URL="https://your-domain.com"
